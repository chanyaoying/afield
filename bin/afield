# How each setting takes effect after a change: "supervisor" (restart afield-supervisor; running
# sessions are untouched), "install" (rerun install.sh, which rewrites a systemd drop-in) or
# "restart" (install.sh, and it only fully applies once the services restart, which restarts
# every session). `afield config set` restarts the supervisor itself and only tells you the rest.
CONFIG_HELP = {
    "served_dir": ("the folder the Remote Control server serves; new sessions run here", "restart"),
    "even_port": ("Even Terminal's port", "restart"),
    "max_open": ("sessions the supervisor reopens at once (each ~300-500 MB); new ones are not "
                 "blocked", "supervisor"),
    "memory_max_gb": ("hard memory cap for all sessions together (afield.slice; soft at 75%)", "install"),
    "defer_above_gb": ("no more reopens once the sessions use this much memory", "supervisor"),
    "idle_seconds": ("idle this long before a session is moved, adopted or relaunched", "supervisor"),
    "archive_sync": ("archiving a running chat in the app retires it here (unofficial API)", "supervisor"),
    "phone_titles": ("name windows after the chat's title in the app (unofficial API)", "supervisor"),
    "retire_archives": ("`afield retire` also archives the chat in the app (unofficial API, your "
                        "Claude login; at your own risk)", "supervisor"),
    "auto_trust_dirs": ("folders whose \"trust this folder?\" prompt is answered yes, e.g. ~",
                        "supervisor"),
    "glasses_only_afield": ("the glasses list only afield's sessions, under their phone titles",
                            "restart"),
    "alerts_url": ("webhook told when a contract fails or passes again; empty: no alerts "
                   "(test it: afield alert test)", "supervisor"),
    "alerts_format": ("how alerts_url is called: json (signed if the secret file exists), ntfy, "
                      "slack or discord", "supervisor"),
    "alerts_secret_file": ("json: HMAC key the request is signed with; ntfy: access token. "
                           "Keep it mode 600; never put it in this file", "supervisor"),
}
CONFIG_APPLY = {
    "supervisor": "takes effect when the supervisor restarts (config set does that; sessions keep running)",
    "install": "takes effect after ./install.sh in the afield repo (sessions keep running)",
    "restart": "needs ./install.sh, and fully applies only once the services restart, "
               "which restarts every session",
}
INTEGER_KEYS = {"max_open", "even_port"}


def config_value_ok(key, value, defaults=CONFIG_DEFAULTS):
    """Is value an acceptable setting for key (same type as the default; numbers above 0)?"""
    want = defaults[key]
    if isinstance(want, bool):
        return isinstance(value, bool)
    if isinstance(want, (int, float)):
        kinds = int if key in INTEGER_KEYS else (int, float)
        return isinstance(value, kinds) and not isinstance(value, bool) and value > 0
    if isinstance(want, list):
        return isinstance(value, list) and all(isinstance(v, str) for v in value)
    if key == "alerts_url":  # plain http only to this machine: the body and signature are not secret-safe
        return isinstance(value, str) and (value.startswith("https://") or bool(
            re.match(r"http://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(/|$)", value)))
    if key == "alerts_format":
        return value in ALERT_FORMATS
    return isinstance(value, type(want)) and value != ""


def parse_config_value(key, words, defaults=CONFIG_DEFAULTS):
    """The value `afield config set <key> <words...>` means, or ValueError saying why not.
    Booleans: true/false/on/off/yes/no. Lists: each word (or comma-separated part) is an item,
    or one JSON list; `[]` empties it. Everything else takes exactly one word."""
    if key not in defaults:
        raise ValueError(f"no config key {key!r} (known: {', '.join(defaults)})")
    want = defaults[key]
    if isinstance(want, list):
        if len(words) == 1 and words[0].lstrip().startswith("["):
            try:
                value = json.loads(words[0])
            except ValueError:
                raise ValueError(f"{key}: {words[0]!r} is not a JSON list") from None
        else:
            value = [part.strip() for w in words for part in w.split(",") if part.strip()]
            if not value:
                raise ValueError(f"{key}: give one or more folders, or [] for none")
    elif len(words) != 1:
        raise ValueError(f"{key} takes one value, got {len(words)}")
    elif isinstance(want, bool):
        text = words[0].lower()
        if text not in ("true", "false", "on", "off", "yes", "no"):
            raise ValueError(f"{key}: {words[0]!r} is not true or false")
        value = text in ("true", "on", "yes")
    elif isinstance(want, (int, float)):
        try:
            value = int(words[0])
        except ValueError:
            try:
                value = float(words[0])
            except ValueError:
                raise ValueError(f"{key}: {words[0]!r} is not a number") from None
    else:
        value = words[0]
    if not config_value_ok(key, value, defaults):
        if key in INTEGER_KEYS:
            rule = "a whole number above 0"
        elif isinstance(want, (int, float)) and not isinstance(want, bool):
            rule = "a number above 0"
        else:
            rule = f"default {want!r}"
        raise ValueError(f"{key}: {value!r} is not a valid value ({rule})")
    return value


def config_help(config, path, defaults=CONFIG_DEFAULTS, help_=CONFIG_HELP, apply=CONFIG_APPLY):
    """The text of `afield config help`: how to change settings, then every key."""
    lines = [
        f"Settings live in {path} (or $AFIELD_CONFIG); every key is optional.",
        "",
        "  afield config               every setting in use (defaults + the file)",
        "  afield config <key>         one value, for scripts",
        "  afield config set <key> <value...>",
        "                              check and save a value; restarts the supervisor when that",
        "                              is all it needs (sessions keep running), otherwise says",
        "                              whether ./install.sh or a full restart is needed",
        "  afield config unset <key>   back to the default (same rules)",
        "  afield config help          this text",
        "",
        "  Values: true/false (or on/off, yes/no); numbers; lists as separate words,",
        "  comma-separated, or [] for empty. Example: afield config set max_open 10",
        "",
        "Keys: current value (default; what a change needs)",
    ]
    for key, default in defaults.items():
        text, how = help_[key]
        now = json.dumps(masked_url(config.get(key, default)) if key == "alerts_url" else config.get(key, default))
        lines.append(f"  {key:<20} {now}  (default {json.dumps(default)}; {how})")
        lines.append(f"  {'':<20} {text}")
    lines += ["", "What a change needs:"] + [f"  {k:<11} {v}" for k, v in apply.items()]
    return "\n".join(lines)


def load_config(path=None, defaults=CONFIG_DEFAULTS):
    """(config, problems): the defaults overlaid with the file's values. A missing file is fine;
    an unreadable one, an unknown key or a value of the wrong type is a problem and is ignored."""
    config, problems = dict(defaults), []
    try:
        with open(path or CONFIG_PATH) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return config, problems
    except (OSError, ValueError) as err:
        return config, [f"cannot read {path or CONFIG_PATH}: {err}"]
    if not isinstance(data, dict):
        return config, [f"{path or CONFIG_PATH}: expected a JSON object"]
    for key, value in data.items():
        if key not in defaults:
            problems.append(f"unknown key {key!r} (known: {', '.join(defaults)})")
        elif config_value_ok(key, value, defaults):
            config[key] = value
        else:
            problems.append(f"{key}: {value!r} is not a valid value (default {defaults[key]!r})")
    return config, problems


